root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,slnx}]
indent_size = 4

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# EF Core migrations are generated; keep analyzers and style rules off them.
[**/Migrations/*.cs]
generated_code = true

[*.md]
trim_trailing_whitespace = false

[justfile]
indent_size = 4
