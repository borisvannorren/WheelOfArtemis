# Copy to .env and adjust if needed.

# Development database. Only reachable from this machine.
POSTGRES_DB=wheel_of_artemis
POSTGRES_USER=artemis
POSTGRES_PASSWORD=artemis-local-only

# Development host ports. Change them if they clash with other projects running on your machine.
APP_PORT=5000
POSTGRES_HOST_PORT=5433

# Production hosting (`just prod-up`). The app is published on this address and port only.
# Use 127.0.0.1 to keep it on this machine, or a network address of this machine to share it with the team.
PROD_BIND_ADDRESS=127.0.0.1
PROD_PORT=5001
# Shared login for everyone who opens the app. Pick your own values and share them with the team.
PROD_USERNAME=artemis
PROD_PASSWORD=
# Password of the production database; only the app container uses it.
PROD_POSTGRES_PASSWORD=
