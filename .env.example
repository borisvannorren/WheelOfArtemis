# Copy to .env and adjust if needed. Only used locally; the database is not reachable from outside this machine.
POSTGRES_DB=wheel_of_artemis
POSTGRES_USER=artemis
POSTGRES_PASSWORD=artemis-local-only

# Host ports. Change them if they clash with other projects running on your machine.
APP_PORT=5000
PROD_APP_PORT=5001
POSTGRES_HOST_PORT=5433
